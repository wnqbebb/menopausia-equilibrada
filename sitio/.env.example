# Copia estas variables en Vercel → tu proyecto → Settings → Environment Variables.
# NO pongas valores reales en este archivo ni en el repositorio.

# Obligatoria. Clave del panel /oferta/admin.html y firma de enlaces, códigos de la app y ofertas.
# Genera una: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=cambia-esto-por-una-clave-larga

# Dominio público desde donde compran (sin barra al final).
PUBLIC_URL=https://tu-proyecto.vercel.app

# Opcional. Otra carpeta o CDN para los 13 PDF (termina en /). Si se deja vacía, los PDF salen del propio Vercel.
FILES_BASE=

# --- Base de datos (Vercel → Storage). Se crean solas al conectar el almacén al proyecto ---
# Opción recomendada para cientos o miles de ventas: Upstash Redis (Marketplace)
# UPSTASH_REDIS_REST_URL=      (o KV_REST_API_URL)
# UPSTASH_REDIS_REST_TOKEN=    (o KV_REST_API_TOKEN)
# Opción para empezar: Vercel Blob privado
# BLOB_READ_WRITE_TOKEN=

# --- Whop (recomendado para cobrar) ---
WHOP_API_KEY=
WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx
WHOP_PRODUCT_ID=prod_xxxxxxxxxxxxx
WHOP_WEBHOOK_SECRET=ws_xxxxxxxxxxxxxxxx
# Opcional: otros productos de Whop (prod_…, separados por comas) cuyas ventas directas también dan acceso a PLENA.
WHOP_PRODUCTOS_DIRECTOS=

# --- Cuentas de PLENA (Supabase, plan gratis). Ver docs/11-CUENTAS-Y-SUPABASE.md ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave pública (publishable «sb_publishable_…» o la «anon» antigua): la recibe el navegador por /api/config.
SUPABASE_ANON_KEY=
# Clave SECRETA (secret «sb_secret_…» o la «service_role» antigua): solo en Vercel, nunca en el navegador ni en GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo (Gmail con contraseña de aplicación) ---
GMAIL_USER=cristinaaguilarrojas1@gmail.com
GMAIL_APP_PASSWORD=

# --- Stripe (alternativa) ---
STRIPE_SECRET_KEY=

# --- Enlaces de pago externos (Hotmart, Mercado Pago…) ---
PAY_LINK_TODO=
# PAY_LINK_PAUSA=   PAY_LINK_K1=   … (un enlace por producto suelto, opcional)
