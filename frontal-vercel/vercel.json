{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/comprar",
      "destination": "/oferta/",
      "permanent": true
    },
    {
      "source": "/pack",
      "destination": "/oferta/",
      "permanent": true
    },
    {
      "source": "/oferta",
      "destination": "/oferta/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?f=index"
    },
    {
      "source": "/index.html",
      "destination": "/api/page?f=index"
    },
    {
      "source": "/oferta/",
      "destination": "/api/page?f=oferta"
    },
    {
      "source": "/oferta/index.html",
      "destination": "/api/page?f=oferta"
    },
    {
      "source": "/oferta/gracias.html",
      "destination": "/api/page?f=gracias"
    },
    {
      "source": "/oferta/admin.html",
      "destination": "/api/page?f=admin"
    },
    {
      "source": "/_src/:path*",
      "destination": "/api/page?f=index"
    },
    {
      "source": "/:path*",
      "destination": "https://menopausia-equilibrada.netlify.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/oferta/img/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=604800"
        }
      ]
    },
    {
      "source": "/img/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=604800"
        }
      ]
    },
    {
      "source": "/icons/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=604800"
        }
      ]
    },
    {
      "source": "/vendor/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=604800"
        }
      ]
    },
    {
      "source": "/entrega-:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=86400"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=120"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=3600"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}